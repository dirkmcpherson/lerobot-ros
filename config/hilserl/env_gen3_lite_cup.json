{
  "env": {
    "name": "real_robot",
    "task": "gen3_lite_cup_pick_place",
    "fps": 10,
    "robot": {
      "type": "gen3_lite_hil",
      "use_gripper": true,
      "fixed_gripper_position": null,
      "control_period_s": 0.1,
      "ee_step_size_m": 0.01,
      "max_ee_step_m": 0.01,
      "max_ee_speed_m_s": 0.1,
      "ee_bounds_min": [
        0.15,
        0.03,
        0.04
      ],
      "ee_bounds_max": [
        0.43,
        0.29,
        0.3
      ],
      "watchdog_periods": 3.0,
      "max_obs_age_s": 0.2,
      "home_on_connect": true,
      "cameras": {
        "front": {
          "type": "opencv",
          "index_or_path": 0,
          "fps": 30,
          "width": 640,
          "height": 480
        }
      },
      "reset_joint_positions": [
        -0.255,
        -0.607,
        2.202,
        0.249,
        -1.469,
        -1.227
      ]
    },
    "teleop": {
      "type": "gamepad",
      "use_gripper": true
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": null,
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "reset_time_s": 8.0,
        "control_time_s": 20.0,
        "terminate_on_success": true,
        "fixed_reset_joint_positions": null
      },
      "inverse_kinematics": null,
      "reward_classifier": null,
      "max_gripper_pos": null
    },
    "features": {
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.state": {
        "type": "STATE",
        "shape": [
          10
        ]
      },
      "action": {
        "type": "ACTION",
        "shape": [
          3
        ]
      }
    },
    "features_map": {
      "observation.images.front": "observation.images.front",
      "observation.state": "observation.state",
      "action": "action"
    }
  },
  "dataset": {
    "repo_id": "local/gen3_lite_cup_hil_demos",
    "root": "data/gen3_lite_cup_hil_demos",
    "task": "pick up the cup and place it on the mark",
    "num_episodes_to_record": 20,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
