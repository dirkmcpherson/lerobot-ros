{
  "env": {
    "name": "real_robot",
    "task": "gen3_lite_reach_gazebo",
    "fps": 10,
    "robot": {
      "type": "gen3_lite_hil",
      "use_gripper": false,
      "fixed_gripper_position": null,
      "control_period_s": 0.1,
      "ee_step_size_m": 0.01,
      "max_ee_step_m": 0.01,
      "max_ee_speed_m_s": 0.1,
      "ee_bounds_min": [
        0.15,
        0.03,
        0.04
      ],
      "ee_bounds_max": [
        0.43,
        0.29,
        0.4
      ],
      "watchdog_periods": 3.0,
      "max_obs_age_s": 0.2,
      "home_on_connect": true,
      "cameras": {},
      "reset_joint_positions": [
        -0.255,
        -0.607,
        2.202,
        0.249,
        -1.469,
        -1.227
      ],
      "use_sim_time": true
    },
    "teleop": {
      "type": "scripted_ee",
      "use_gripper": false,
      "takeovers": [
        [
          10,
          40
        ]
      ],
      "max_takeover_episodes": null,
      "always_intervene": true,
      "target": [
        0.34,
        0.11,
        0.26
      ],
      "success_radius_m": 0.015,
      "episode_steps": 59,
      "ee_step_size_m": 0.01
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "display_cameras": false
      },
      "image_preprocessing": null,
      "gripper": {
        "use_gripper": false,
        "gripper_penalty": 0.0
      },
      "reset": {
        "reset_time_s": 1.0,
        "control_time_s": 6.0,
        "terminate_on_success": true,
        "fixed_reset_joint_positions": null
      },
      "inverse_kinematics": null,
      "reward_classifier": null,
      "max_gripper_pos": null
    },
    "features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          10
        ]
      },
      "action": {
        "type": "ACTION",
        "shape": [
          3
        ]
      }
    },
    "features_map": {
      "observation.state": "observation.state",
      "action": "action"
    }
  },
  "dataset": {
    "repo_id": "local/gazebo_reach_demos",
    "root": "data/gazebo_reach_demos",
    "task": "reach the target",
    "num_episodes_to_record": 10,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
